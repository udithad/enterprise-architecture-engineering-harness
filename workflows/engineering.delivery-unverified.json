{
  "id": "engineering.delivery-unverified",
  "version": "1.0.0",
  "description": "Governed software delivery WITHOUT build/test execution by EAEH (explicitly deferred per project): approved design \u2192 plan \u2192 approval \u2192 implementation with tests \u2192 source bundle (marked unverified) \u2192 approval \u2192 export.",
  "initial": "plan",
  "states": [
    {
      "name": "plan",
      "type": "agent_task",
      "task_kind": "implementation-planning",
      "capabilities": [
        "implementation-planning"
      ],
      "max_autonomy": "read_only",
      "artifact": "delivery/implementation-plan.json",
      "inputs": {
        "requirements": {
          "$input": "/requirements"
        },
        "hld": {
          "$input": "/hld"
        },
        "lld": {
          "$input": "/lld"
        },
        "project": {
          "$input": "/project"
        }
      },
      "quality_gate": {
        "gate": "delivery-plan",
        "context": {
          "requirements": {
            "$input": "/requirements"
          }
        }
      },
      "timeout_secs": 3600,
      "transitions": {
        "succeeded": "approve_plan",
        "failed": "failed",
        "timed_out": "failed"
      }
    },
    {
      "name": "approve_plan",
      "type": "approval_gate",
      "required_role": "approver",
      "artifact_from": "plan",
      "max_revisions": 3,
      "transitions": {
        "approved": "implement",
        "changes_requested": "plan",
        "rejected": "rejected"
      }
    },
    {
      "name": "implement",
      "type": "agent_task",
      "task_kind": "implementation",
      "capabilities": [
        "implementation"
      ],
      "max_autonomy": "workspace_modify",
      "requires_approval_of": [
        "approve_plan"
      ],
      "artifact": "delivery/implementation.json",
      "inputs": {
        "plan": {
          "$output": "plan"
        },
        "requirements": {
          "$input": "/requirements"
        },
        "lld": {
          "$input": "/lld"
        },
        "project": {
          "$input": "/project"
        }
      },
      "quality_gate": {
        "gate": "delivery",
        "context": {
          "requirements": {
            "$input": "/requirements"
          }
        }
      },
      "timeout_secs": 3600,
      "transitions": {
        "succeeded": "snapshot",
        "failed": "failed",
        "timed_out": "failed"
      }
    },
    {
      "name": "snapshot",
      "type": "tool_step",
      "tool": "delivery.snapshot",
      "input": {
        "implementation": {
          "$output": "implement"
        },
        "verification": "NOT EXECUTED BY EAEH: build and test verification was explicitly deferred for this project ([delivery] build_verification = \"deferred\"). Run the build and tests before relying on this code."
      },
      "artifact": "delivery/source",
      "bundle": true,
      "transitions": {
        "succeeded": "approve_delivery",
        "failed": "failed"
      }
    },
    {
      "name": "approve_delivery",
      "type": "approval_gate",
      "required_role": "approver",
      "artifact_from": "snapshot",
      "max_revisions": 3,
      "transitions": {
        "approved": "done",
        "changes_requested": "implement",
        "rejected": "rejected"
      }
    },
    {
      "name": "done",
      "type": "terminal",
      "outcome": "succeeded"
    },
    {
      "name": "rejected",
      "type": "terminal",
      "outcome": "failed"
    },
    {
      "name": "failed",
      "type": "terminal",
      "outcome": "failed"
    }
  ]
}
