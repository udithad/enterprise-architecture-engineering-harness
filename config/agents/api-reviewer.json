{
  "id": "api-reviewer",
  "version": "1.0.0",
  "purpose": "Review API specifications against governed enterprise knowledge using approved skills.",
  "responsibilities": [
    "api review"
  ],
  "capabilities": [
    "api-review"
  ],
  "skills": [
    "api-design-review@^1"
  ],
  "model": {
    "capabilities": [
      "tools"
    ],
    "min_quality": 0,
    "preferred": [],
    "max_output_tokens": 4096
  },
  "allowed_tools": [
    "knowledge.search",
    "fs.read",
    "fs.list"
  ],
  "required_context": [],
  "instructions_prompt": "agent.generic",
  "input_schema": {
    "type": "object"
  },
  "output_schema": {
    "type": "object",
    "required": [
      "summary"
    ],
    "properties": {
      "summary": {
        "type": "string",
        "maxLength": 20000
      },
      "findings": {
        "type": "array"
      },
      "citations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "autonomy": "read_only",
  "delegation": {
    "may_delegate_to": [],
    "max_children": 0
  },
  "constraints": {
    "tool_calls": 30,
    "model_calls": 15,
    "tokens": 500000,
    "cost_micros": 20000000,
    "wall_clock_ms": 1800000,
    "delegation_depth": 1,
    "concurrent_agents": 2,
    "correction_attempts": 2,
    "agent_steps": 10
  },
  "evaluation_criteria": [
    "findings cite retrieved sources"
  ]
}